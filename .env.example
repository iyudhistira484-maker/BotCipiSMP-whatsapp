# =====================================================================
# ✿ KONFIGURASI UTAMA BOT WHATSAPP CIPISMP ✿
# Salin file ini menjadi .env lalu isi sesuai server kamu:
#   cp .env.example .env
# JANGAN PERNAH meng-commit file .env ke GitHub!
# =====================================================================

# --- 1. IDENTITAS & LOGIN PAIRING WHATSAPP ---
BOT_NAME=CipiSMP Bot
BOT_FOOTER=✦ ᴄɪᴘɪsᴍᴘ ᴋᴀᴡᴀɪɪ ʙᴏᴛ ♡
PREFIX=.

# Nomor WhatsApp bot untuk Pairing Code (format internasional tanpa + / spasi)
# Contoh: 6281234567890
PAIRING_NUMBER=6281234567890

# Nomor Owner (pisahkan dengan koma jika lebih dari satu)
OWNER_NUMBERS=6281234567890
OWNER_NAME=Owner CipiSMP

# Lokasi folder session WhatsApp
SESSION_DIR=./session

# --- 2. FITUR TAMPILAN & KEAMANAN OPERASIONAL ---
# Aktifkan tombol interaktif (true/false). Jika false atau gagal, otomatis fallback teks
USE_BUTTONS=true
# Mode simulasi (true/false). Jika true, broadcast/bridge/kontrol server tidak benar-benar dikirim
DRY_RUN=false
# Izinkan command diagnostik .eval khusus Owner (default false demi keamanan produksi!)
ENABLE_OWNER_EVAL=false
# Zona waktu wajib Asia/Jakarta (WIB)
TZ=Asia/Jakarta
# Level log: info | warn | error | debug
LOG_LEVEL=info

# --- 3. TAUTAN KOMUNITAS ---
DISCORD_INVITE_URL=https://discord.gg/cipismp
WA_GROUP_URL=https://chat.whatsapp.com/invitecode
WEBSITE_URL=https://cipismp.my.id

# --- 4. LIMIT HARIAN, EKONOMI & STIKER ---
FREE_AI_LIMIT=15
PREMIUM_AI_LIMIT=100
FREE_DOWNLOADER_LIMIT=15
PREMIUM_DOWNLOADER_LIMIT=100
DEFAULT_COOLDOWN_SEC=4
WORK_COOLDOWN_MIN=30
LEVELUP_NOTIFY=true
STICKER_PACK_NAME=CipiSMP Kawaii Pack ✿
STICKER_AUTHOR=CipiSMP Bot ♡

# --- 5. MINECRAFT SERVER & GEYSER (BEDROCK) ---
MC_HOST=play.cipismp.my.id
MC_PORT=25565
MC_BEDROCK_PORT=19132
MC_BEDROCK_PREFIX=.
MC_DAILY_REWARD_LIMIT=3

# --- 6. JEMBATAN KOMUNITAS / BRIDGE WA <-> MC <-> DISCORD (Fase 4) ---
# Daftar JID grup WA untuk bridge 2 arah, pisahkan koma (bisa juga diaktifkan lewat command .bridge on di grup)
WA_BRIDGE_GROUP_JIDS=
BRIDGE_NOTIFY_JOIN_LEAVE=true
BRIDGE_NOTIFY_STATUS=true

# --- 7. PTERODACTYL PANEL & RCON (Fase 3 & 4) ---
PTERO_PANEL_URL=https://panel.cipismp.my.id
PTERO_CLIENT_API_KEY=
PTERO_SERVER_ID=
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# --- 8. DISCORD WEBHOOK & BOT (Fase 3, 4 & 5) ---
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_BRIDGE_CHANNEL_ID=
DISCORD_STATUS_CHANNEL_ID=
DISCORD_TICKET_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# --- 9. AI PROVIDER & DOWNLOADER (Fase 3) ---
# Pilihan provider: openai | gemini | groq | openrouter
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=

# Opsional: Endpoint Cobalt / Custom API Downloader sendiri (otomatis fallback ke API publik bila kosong)
COBALT_API_URL=
DOWNLOADER_API_KEY=

# --- 10. CIPI PANEL (DASHBOARD KONTROL BOT & RESOURCE VPS) ---
PANEL_ENABLED=true
PANEL_HOST=0.0.0.0
PANEL_PORT=3000
PANEL_USERNAME=admin
# WAJIB isi password kuat sebelum diekspos ke publik! Jika kosong, PIN acak sekali jalan dicetak di log konsol.
PANEL_PASSWORD=
PANEL_SESSION_SECRET=


